NODE_ENV=production
PORT=3000
PUBLIC_ORIGIN=https://SEU-DOMINIO.com.br
TRUST_PROXY=1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=boteco
DB_USER=boteco
DB_PASSWORD=SUBSTITUA_PELA_SENHA_DO_BANCO
UPLOAD_DIR=/var/lib/boteco/uploads

# For remote MariaDB, enable verified TLS and optionally provide a CA file.
DB_SSL=false
DB_SSL_CA=

# External object storage (required in production). Never commit real credentials.
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_FORCE_PATH_STYLE=false
