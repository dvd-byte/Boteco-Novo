NODE_ENV=development
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=boteco
DB_USER=boteco
DB_PASSWORD=
TRUST_PROXY=0
UPLOAD_DIR=./uploads

# For remote MariaDB, enable verified TLS and optionally provide a CA file.
DB_SSL=false
DB_SSL_CA=

# External object storage (required in production). Never commit real credentials.
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_FORCE_PATH_STYLE=false
